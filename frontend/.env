# Set your deployed backend URL here (e.g. https://api.kitayi.com/api/v1)
# Leave empty to use relative path (same origin — works with Vercel proxying)
# VITE_API_URL=

# Firebase config — get these from Firebase Console → Project Settings → General → Web Apps
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=kitayi-water.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://kitayi-water-default-rtdb.firebaseio.com
# VITE_FIREBASE_PROJECT_ID=kitayi-water
# VITE_FIREBASE_STORAGE_BUCKET=kitayi-water.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

